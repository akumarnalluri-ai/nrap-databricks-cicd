# Force Unix line endings for everything the Linux runner executes or parses.
# (Files edited on Windows/OneDrive would otherwise get CRLF and break bash.)
*.sh    text eol=lf
*.env   text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.py    text eol=lf
*.md    text eol=lf
# PowerShell runs on Windows - keep CRLF there.
*.ps1   text eol=crlf
