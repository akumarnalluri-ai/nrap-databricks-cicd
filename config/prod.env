# =============================================================================
# Pipeline settings for PROD (template - not offered by the workflow yet).
# To enable: add "prod" to the environment options in
# .github/workflows/deploy-databricks.yml and rollback-databricks.yml, and
# create a "prod" GitHub environment with required reviewers.
# =============================================================================

BUNDLE_TARGET=prod

JOB_RESOURCE_KEY=nrap_demo_job
JOB_NAME=nrap_demo_job_prod

RUN_JOB_AFTER_DEPLOY=true
AUTO_ROLLBACK_ON_FAILURE=true

REQUIRE_TAG_ON_MAIN=true
MAIN_BRANCH=main
