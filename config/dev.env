# =============================================================================
# Pipeline settings for the DEV environment (read by the GitHub workflow).
# NON-SECRET values only. Credentials go in GitHub -> Settings -> Environments
# -> dev -> Environment secrets (DATABRICKS_HOST, DATABRICKS_TOKEN ...).
#
# Databricks-side settings (catalog, schema, env name) live in databricks.yml
# under targets.dev - this file only controls how the pipeline behaves.
# Format: KEY=VALUE, no spaces around "=", no quotes needed.
# =============================================================================

# databricks.yml target to deploy
BUNDLE_TARGET=dev

# Bundle job resource key and the deployed job name (resources/nrap_demo_job.yml)
JOB_RESOURCE_KEY=nrap_demo_job
JOB_NAME=nrap_demo_job_dev

# Run the job after deploying (it contains the validation task). true/false
RUN_JOB_AFTER_DEPLOY=true

# If deploy or validation fails, redeploy the version that was live before. true/false
AUTO_ROLLBACK_ON_FAILURE=true

# Require the tag to be on the main branch history before deploying. true/false
REQUIRE_TAG_ON_MAIN=false

# Name of the protected branch (used when REQUIRE_TAG_ON_MAIN=true)
MAIN_BRANCH=main
