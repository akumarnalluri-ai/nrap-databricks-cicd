# =============================================================================
# Pipeline settings for the TEST environment (read by the GitHub workflow).
# NON-SECRET values only. Credentials go in GitHub -> Settings -> Environments
# -> test -> Environment secrets. Approval is configured on the "test"
# GitHub environment (Required reviewers) - see docs/03_GITHUB_SETUP.md.
# =============================================================================

BUNDLE_TARGET=test

JOB_RESOURCE_KEY=nrap_demo_job
JOB_NAME=nrap_demo_job_test

RUN_JOB_AFTER_DEPLOY=true
AUTO_ROLLBACK_ON_FAILURE=true

# Higher environments should only receive releases cut from main.
REQUIRE_TAG_ON_MAIN=true
MAIN_BRANCH=main
